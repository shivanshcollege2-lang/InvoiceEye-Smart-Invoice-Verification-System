PORT=5050
JWT_SECRET=change-this-secret
# SQLite runs locally without a separate database service. Set DB_MODE=mysql to use MySQL.
DB_MODE=sqlite
OWNER_EMAIL=shivanshcollege2@gmail.com
# Set a private password before first startup. Do not commit your .env file.
OWNER_PASSWORD=
OWNER_NAME=
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=invoiceeye
MYSQL_USER=invoiceeye
MYSQL_PASSWORD=invoiceeye
MYSQL_ROOT_PASSWORD=rootpassword
SQLITE_PATH=server/db/invoiceeye.sqlite
UPLOAD_DIR=server/uploads
MAX_DOCUMENT_PAGES=20
# Comma-separated browser origins permitted to call the API directly.
# CORS_ORIGIN=http://127.0.0.1:5173,https://your-demo.example
# Optional: the server automatically prefers its project .venv when available.
# Windows: PYTHON_BIN=.venv\Scripts\python.exe
# macOS/Linux: PYTHON_BIN=.venv/bin/python
# Set this if Tesseract is installed outside PATH:
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
